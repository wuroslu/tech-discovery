{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed Chinese daily technology digest",
  "type": "object",
  "required": [
    "schema_version",
    "timezone",
    "editions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timezone": {
      "const": "Asia/Shanghai"
    },
    "editions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edition"
      }
    }
  },
  "$defs": {
    "edition": {
      "type": "object",
      "required": [
        "date",
        "status",
        "published_at",
        "items"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "description": "The edition/news date, not an invented publication timestamp."
        },
        "status": {
          "enum": [
            "draft",
            "published"
          ]
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "description": "Actual editorial publication time, may be later than edition date for backfills."
        },
        "editor_note": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/story"
          }
        }
      }
    },
    "story": {
      "type": "object",
      "required": [
        "id",
        "title_zh",
        "what_zh",
        "why_zh",
        "category",
        "url",
        "original_title",
        "source_name",
        "source_language",
        "source_published_at",
        "checked_at",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{5,80}$",
          "description": "Stable ID chosen once. Never change when editing title or summary."
        },
        "title_zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70
        },
        "what_zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 350,
          "description": "Concise source-supported facts, not title-based guessing."
        },
        "why_zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "description": "Editorial judgment, visibly labeled separately from facts."
        },
        "caveat_zh": {
          "type": "string"
        },
        "category": {
          "enum": [
            "ai",
            "hardware",
            "software"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "original_title": {
          "type": "string",
          "minLength": 1
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_language": {
          "enum": [
            "zh",
            "en"
          ],
          "description": "The original source language. Chinese and English originals are both valid."
        },
        "source_published_at": {
          "type": "string",
          "description": "Verified original date or timestamp; do not invent a time when only a date is shown."
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_status": {
          "enum": [
            "pending",
            "reviewed"
          ]
        }
      }
    }
  }
}
